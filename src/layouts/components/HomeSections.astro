---
// Homepage sections below the hero: lifecycle (service pillars as steps),
// audience cards, and the "why us" band. Cards follow the services-hub
// pattern — the whole card is one <a>, so descriptions must stay plain text.
const { lifecycle, audiences, why } = Astro.props;
---

{lifecycle && (
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <h2>{lifecycle.title}</h2>
          {lifecycle.intro && <p class="mt-4 text-text">{lifecycle.intro}</p>}
          <div class="row">
            {lifecycle.steps?.map((step: any, index: number) => (
              <div class="mt-8 md:col-6">
                <a
                  href={step.url}
                  class="block h-full rounded-lg border border-border bg-white p-8 transition-all duration-200 hover:border-primary hover:shadow-lg"
                >
                  <span class="font-secondary font-bold text-primary">{String(index + 1).padStart(2, "0")}</span>
                  <h3 class="h4 mt-2 text-dark">{step.title}</h3>
                  <p class="mt-4 text-text">{step.description}</p>
                </a>
              </div>
            ))}
          </div>
          {lifecycle.hub && (
            <p class="mt-8">
              <a class="text-primary hover:underline" href={lifecycle.hub.url}>{lifecycle.hub.label} →</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
)}

{audiences && (
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <h2>{audiences.title}</h2>
          <div class="row">
            {audiences.items?.map((item: any) => (
              <div class="mt-8 md:col-4">
                <a
                  href={item.url}
                  class="block h-full rounded-lg border border-border bg-white p-8 transition-all duration-200 hover:border-primary hover:shadow-lg"
                >
                  <h3 class="h4 text-dark">{item.title}</h3>
                  <p class="mt-4 text-text">{item.description}</p>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{why && (
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <h2>{why.title}</h2>
          <div class="row">
            {why.items?.map((item: any) => (
              <div class="mt-8 md:col-4">
                <h3 class="h5 text-dark">{item.title}</h3>
                <p class="mt-3 text-text">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
