---
import { markdownify } from "@lib/utils/textConverter";
import { Image } from "astro:assets";
import CustomerLogos from "./CustomerLogos.astro";
const { banner } = Astro.props;
const { title, image, content, customers, ctabutton, ctaphone } = banner;
---

<section class="section banner relative">
  <div class="container">
    <div class="row">
      <div class="lg:col-8 sm:col-12">
        <h1 set:text={title} />
        <div class="mt-8" set:html={markdownify(content)} />
        {(ctabutton || ctaphone) && (
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            {ctabutton && (
              <a class="btn btn-primary" href={ctabutton.link}>{ctabutton.label}</a>
            )}
            {ctaphone && (
              <a class="whitespace-nowrap text-dark hover:text-primary" href={ctaphone.link}>{ctaphone.label}</a>
            )}
          </div>
        )}
        {customers &&
          <CustomerLogos customers={customers} />
        }
      </div>
      {image &&
        <div class="hidden lg:block lg:col-4">
          <Image
            class="mx-auto max-w-[50%] lg:max-w-full object-contain mt-8"
            style="user-select: none; pointer-events: none;"
            alt="banner"
            src={image}
            width={400}
            height={400}
            decoding="sync"
            loading="eager"
          />
        </div>
      }
    </div>
  </div>
</section>
