---
import config from "@config/config.json";
const canonical = new URL("/de/", config.site.base_url).toString();
---
<head>
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={ `0; url=/de/` } />
  <link rel="canonical" href={canonical} />
  <script>
    window.setTimeout(() => {
      document.getElementById('redirectlink').style.opacity = '1';
    }, 2000);
  </script>
</head>
<body>
<a id="redirectlink" href="/de/" style="opacity: 0; transition: opacity; transition-duration: 1000ms;">Please go here for now...</a>
</body>
