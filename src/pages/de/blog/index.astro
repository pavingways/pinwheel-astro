---
import Blogs from "@components/Blogs.astro";
import PageHeader from "@components/PageHeader.astro";
import BlogCategories from "@components/blog/BlogCategories.astro";
import FeaturedBlog from "@components/blog/FeaturedBlog.astro";
import config from "@config/config.json";
import Base from "@layouts/Base.astro";
import Pagination from "@layouts/components/Pagination.astro";
import Cta from "@layouts/partials/Cta.astro";
import { getSinglePage } from "@lib/contentParser.astro";
import { getTaxonomy } from "@lib/taxonomyParser.astro";
import { sortByDate, splitFeaturedPosts } from "@lib/utils/sortFunctions";
import { getEntryBySlug } from "astro:content";
import { getI18nStrings } from "@lib/utils/i18n";
const i18n = getI18nStrings(Astro.currentLocale);

const { blog_folder } = config.settings;
const blogIndex: Record<string, any> = await getEntryBySlug<any, string>(blog_folder, "-index") || {};
// legacy 2006-2014 posts have their own archive (/categories/historic/) so they
// don't dilute the current posts on the main blog listing
const posts = (await getSinglePage(blog_folder, "de")).filter(
  (post) => !post.data.categories.includes("historic")
);
const categories = await getTaxonomy(config.settings.blog_folder, "categories", "de");
const sortedPosts = sortByDate(posts);
// top block: newest post + featured post (or 2nd-newest, if none is featured)
const { topPosts, restPosts } = splitFeaturedPosts(sortedPosts);
const totalPages = Math.ceil(restPosts.length / config.settings.pagination);
const currentPosts = restPosts.slice(0, 3);
const olderPosts = restPosts.slice(3, config.settings.pagination);

---

<Base
  title={i18n.blog.title}
  page_title={i18n.blog.page_title}
  meta_title={i18n.blog.meta_title}
  description={i18n.blog.description}
  image={blogIndex.data.image}
>

  <section class="page-hero pt-16">
    <div class="container">
      <PageHeader page_data={i18n.blog} />
      <div class="mb-2">{i18n.blog.subtitle}</div>
    </div>
  </section>

  <section class="section">

    <div class="container">

      {
        topPosts.length > 0 && (
          <FeaturedBlog posts={topPosts} />
        )
      }
      {
        blogIndex.data.latest_posts && (
          <h2 class="h4 mb-4">{blogIndex.data.latest_posts}</h2>
        )
      }
      {
        currentPosts.length > 0 && (
          <Blogs posts={currentPosts} />
        )
      }
      <BlogCategories categories={categories} all_categories={blogIndex.data.all_categories} />
      {
        olderPosts.length > 0 && (
          <h2 class="h4 mt-20 mb-4">{blogIndex.data.older_posts}</h2>
          <Blogs posts={olderPosts} />
        )
      }

      <Pagination
        section={`${Astro.currentLocale}/${blog_folder}`}
        currentPage={1}
        totalPages={totalPages}
      />

      <div class="mx-auto mt-16 max-w-[883px] border-t border-border pt-8 text-center">
        <p class="text-sm text-text">
          {i18n.blog.archive_note}{" "}
          <a href="/de/categories/historic/" class="font-medium text-primary hover:underline">{i18n.blog.archive_cta} →</a>
        </p>
      </div>

    </div>
  </section>
  <Cta />
</Base>
