---
import Blogs from "@components/Blogs.astro";
import PageHeader from "@components/PageHeader.astro";
import Shape from "@components/Shape.astro";
import config from "@config/config.json";
import Base from "@layouts/Base.astro";
import Pagination from "@layouts/components/Pagination.astro";
import { getSinglePage } from "@lib/contentParser.astro";
import { sortByDate, splitFeaturedPosts } from "@lib/utils/sortFunctions";
import { getEntryBySlug } from "astro:content";
import { getI18nStrings } from "@lib/utils/i18n";

export async function getStaticPaths() {
  // legacy 2006-2014 posts have their own archive (/categories/historic/) so
  // they don't dilute pagination of the current posts
  const posts = (await getSinglePage(config.settings.blog_folder, "de")).filter(
    (post) => !post.data.categories.includes("historic")
  );
  // the top two posts on /de/blog/ (newest + featured/2nd-newest) aren't repeated here
  const { restPosts } = splitFeaturedPosts(sortByDate(posts));
  const totalPages = Math.ceil(restPosts.length / config.settings.pagination);
  const paths = [];

  for (let i = 1; i < totalPages; i++) {
    paths.push({
      params: {
        slug: (i + 1).toString(),
      },
    });
  }
  return paths;
}
const blogIndex = await getEntryBySlug<any, string>(
  config.settings.blog_folder,
  "-index"
);
const { slug } = Astro.params;
const i18n = getI18nStrings(Astro.currentLocale);
// legacy 2006-2014 posts have their own archive (/categories/historic/) so
// they don't dilute pagination of the current posts
const posts = (await getSinglePage(config.settings.blog_folder, "de")).filter(
  (post) => !post.data.categories.includes("historic")
);
const sortedPosts = sortByDate(posts);
// the top two posts on /de/blog/ (newest + featured/2nd-newest) aren't repeated here
const { restPosts } = splitFeaturedPosts(sortedPosts);
const totalPages = Math.ceil(restPosts.length / config.settings.pagination);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastPost = currentPage * config.settings.pagination;
const indexOfFirstPost = indexOfLastPost - config.settings.pagination;
const currentPosts = restPosts.slice(indexOfFirstPost, indexOfLastPost);
const page_data = {
  index_title: blogIndex.data.title,
  slug: `page / ${slug}`,
};
const currentTitle = blogIndex.data.older_posts + " " + currentPage + "/" + totalPages;
---

<Base
  title={currentTitle}
  page_title={currentTitle}
  meta_title={currentTitle}
  description={currentTitle + ": " + blogIndex.data.description}
  image={blogIndex.data.image}
>
  <section class="page-hero pt-16">
    <div class="container">
      <PageHeader page_data={page_data} />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="h4 mb-4">{blogIndex.data.older_posts}</h2>
      <Blogs posts={currentPosts} />
      <Pagination
        section={`${Astro.currentLocale}/${config.settings.blog_folder}`}
        totalPages={totalPages}
        currentPage={currentPage}
      />

      <div class="mx-auto mt-16 max-w-[883px] border-t border-border pt-8 text-center">
        <p class="text-sm text-text">
          {i18n.blog.archive_note}{" "}
          <a href="/de/categories/historic/" class="font-medium text-primary hover:underline">{i18n.blog.archive_cta} →</a>
        </p>
      </div>
    </div>
  </section>
</Base>
